# App
APP_ENV=development
APP_NAME=CareCompass
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# Database
DATABASE_URL=postgresql://carecompass:carecompass@db:5432/carecompass

# Redis (optional, used for caching rankings/search results)
REDIS_URL=redis://redis:6379/0

# External data sources (used by ETL pipeline, not required to run the API)
CMS_CARE_COMPARE_BASE_URL=https://data.cms.gov/provider-data/api/1/datastore/query
GOOGLE_MAPS_API_KEY=
